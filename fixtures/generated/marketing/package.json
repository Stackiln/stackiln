{
  "name": "generated-product",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:unit": "pnpm test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @product/db generate",
    "db:migrate": "pnpm --filter @product/db migrate",
    "db:studio": "pnpm --filter @product/db studio",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "vitest": "3.2.7",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.63.0"
  }
}
